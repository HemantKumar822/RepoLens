# Preferred AI provider. Add this key locally and to Vercel to enable the guide.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint prefix, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local server port
PORT=4173
